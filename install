#!/usr/bin/env python3
"""mcp-msgers installer: copy the shim into the per-user lib dir and write its config.

  install --hub-url http://hub.example.invalid:8465 [--host NAME] [--registry-dir DIR ...]

Idempotent, per host. Copies shim.py into ~/.local/libexec/mcp-msgers/ and writes
~/.config/mcp-msgers/config.json. It writes no OS supervisor unit and does not register
the MCP server with an agent client; the README describes both steps.
"""
from __future__ import annotations

import argparse
import json
import pathlib
import shutil
import socket

HERE = pathlib.Path(__file__).resolve().parent
LIBDIR = pathlib.Path("~/.local/libexec/mcp-msgers").expanduser()
CFGDIR = pathlib.Path("~/.config/mcp-msgers").expanduser()


def host_id(explicit: str | None) -> str:
    if explicit:
        return explicit
    return socket.gethostname().split(".")[0]


def install_files() -> pathlib.Path:
    LIBDIR.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(HERE / "shim.py", LIBDIR / "shim.py")
    shutil.copyfile(HERE / "install", LIBDIR / "install")
    return LIBDIR


def write_config(host: str, hub_url: str, registry_dirs=None) -> dict:
    CFGDIR.mkdir(parents=True, exist_ok=True)
    cfg = {"host": host, "hub_url": hub_url.rstrip("/"), "role": "shim"}
    if registry_dirs:
        cfg["registry_dirs"] = registry_dirs
    (CFGDIR / "config.json").write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    return cfg


def main() -> int:
    ap = argparse.ArgumentParser(description="Install the mcp-msgers shim for this user.")
    ap.add_argument("--hub-url", required=True,
                    help="hub base URL, for example http://hub.example.invalid:8465")
    ap.add_argument("--host", default=None,
                    help="name of this machine (default: the short host name)")
    ap.add_argument("--registry-dir", action="append", default=None,
                    help="extra session registry directory (repeatable)")
    args = ap.parse_args()
    host = host_id(args.host)
    lib = install_files()
    cfg = write_config(host, args.hub_url, args.registry_dir)
    print(f"installed to {lib}")
    print(f"config host={host} hub_url={cfg['hub_url']}")
    print("note: supervisor units and the MCP registration are not written by this installer")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
